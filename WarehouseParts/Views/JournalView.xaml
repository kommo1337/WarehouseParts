<UserControl x:Class="WarehouseParts.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WarehouseParts.ViewModels">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Приход" Command="{Binding AddReceiptCommand}" Padding="20,6" FontSize="14" Margin="0,0,8,0"/>
            <Button Content="Расход" Command="{Binding AddIssueCommand}" Padding="20,6" FontSize="14" Margin="0,0,16,0"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="0,0,16,0"/>
            <TextBlock Text="Фильтр по номеру:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding FilterCode, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0"/>
            <TextBlock Text="Операция:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{x:Static vm:JournalViewModel.FilterTypes}" SelectedItem="{Binding FilterType}" Width="90" Margin="0,0,12,0"/>
            <TextBlock Text="Период с" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding DateFrom}" Width="120" Margin="0,0,6,0"/>
            <TextBlock Text="по" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding DateTo}" Width="120"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH\\:mm}" Width="130"/>
                <DataGridTextColumn Header="Операция" Binding="{Binding OperationTypeDisplay}" Width="80"/>
                <DataGridTextColumn Header="Номер запчасти" Binding="{Binding ItemCode}" Width="110"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding ItemName}" Width="*"/>
                <DataGridTextColumn Header="Единица измерения" Binding="{Binding UnitDisplay}" Width="90"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Остаток после операции" Binding="{Binding BalanceAfter}" Width="150"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Назад" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Вперёд" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"/>
        </StackPanel>
    </Grid>
</UserControl>
