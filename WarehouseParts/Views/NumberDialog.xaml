<Window x:Class="WarehouseParts.Views.NumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:WarehouseParts.Data"
        Title="Номер запчасти"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NumberBox}"
        KeyDown="NumberDialog_OnKeyDown">
    <StackPanel Margin="16">
        <TextBlock Text="Тип номера" Style="{StaticResource HintTextStyle}"/>
        <ComboBox ItemsSource="{x:Static data:DisplayTexts.NumberTypes}" SelectedItem="{Binding NumberTypeText}" Margin="0,3,0,10"/>

        <TextBlock Text="Номер" Style="{StaticResource HintTextStyle}"/>
        <TextBox x:Name="NumberBox" Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>

        <TextBlock Text="Комментарий" Style="{StaticResource HintTextStyle}"/>
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Padding="18,5" Margin="0,0,8,0" ToolTip="Сохранить номер (Enter или Ctrl+Enter)"/>
            <Button Content="Отмена" IsCancel="True" Padding="18,5" ToolTip="Отмена (Esc)"/>
        </StackPanel>
    </StackPanel>
</Window>
