<Window x:Class="WarehouseParts.Views.NumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:WarehouseParts.Data"
        Title="Номер запчасти"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Тип номера"/>
        <ComboBox ItemsSource="{x:Static data:DisplayTexts.NumberTypes}" SelectedItem="{Binding NumberTypeText}" Margin="0,2,0,8"/>

        <TextBlock Text="Номер"/>
        <TextBox Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

        <TextBlock Text="Комментарий"/>
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" IsDefault="True" Padding="12,2" Margin="0,0,8,0"/>
            <Button Content="Отмена" IsCancel="True" Padding="12,2"/>
        </StackPanel>
    </StackPanel>
</Window>
