<UserControl x:Class="WarehouseParts.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WarehouseParts.ViewModels"
             xmlns:ui="clr-namespace:WarehouseParts.Ui"
             xmlns:views="clr-namespace:WarehouseParts.Views"
             Loaded="SearchView_OnLoaded"
             IsVisibleChanged="SearchView_OnIsVisibleChanged">
    <UserControl.Resources>
        <ui:StringToVisibilityConverter x:Key="EmptyStringToVisibility" Invert="True"/>
        <ui:StringToVisibilityConverter x:Key="NonEmptyStringToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="Быстрый поиск" IsChecked="{Binding IsQuickMode}" Margin="0,0,16,0"/>
            <RadioButton Content="Расширенный поиск" IsChecked="{Binding IsAdvancedMode}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2"
                Visibility="{Binding IsQuickMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Введите код, наименование, производителя, применимость или номер"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="{Binding QuickQuery, Converter={StaticResource EmptyStringToVisibility}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=QuickSearchBox}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox x:Name="QuickSearchBox"
                         Grid.Column="0"
                         Text="{Binding QuickQuery, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchField_OnKeyDown"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,7"
                         FontSize="15"/>
                <Button Grid.Column="1"
                        Content="×"
                        ToolTip="Очистить запрос"
                        Command="{Binding ClearQuickCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,2"
                        Visibility="{Binding QuickQuery, Converter={StaticResource NonEmptyStringToVisibility}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="12"
                Margin="0,8,0,0"
                Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel MinWidth="220" Margin="0,0,16,8">
                        <TextBlock Text="Наименование" Style="{StaticResource HintTextStyle}"/>
                        <TextBox Text="{Binding AdvName, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>
                    <StackPanel MinWidth="190" Margin="0,0,16,8">
                        <TextBlock Text="Номер запчасти" Style="{StaticResource HintTextStyle}"/>
                        <TextBox Text="{Binding AdvCode, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>
                    <StackPanel MinWidth="230" Margin="0,0,16,8">
                        <TextBlock Text="Номер" Style="{StaticResource HintTextStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding AdvNumber, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:SearchViewModel.NumberTypeFilterOptions}" SelectedItem="{Binding AdvNumberType}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel MinWidth="190" Margin="0,0,16,8">
                        <TextBlock Text="Производитель" Style="{StaticResource HintTextStyle}"/>
                        <TextBox Text="{Binding AdvManufacturer, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>
                    <StackPanel MinWidth="260" Margin="0,0,16,8">
                        <TextBlock Text="Применимость к автомобилю" Style="{StaticResource HintTextStyle}"/>
                        <TextBox Text="{Binding AdvApplicability, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>
                    <StackPanel MinWidth="170" Margin="0,0,16,8">
                        <TextBlock Text="Наличие" Style="{StaticResource HintTextStyle}"/>
                        <ComboBox ItemsSource="{x:Static vm:SearchViewModel.AvailabilityFilterOptions}" SelectedItem="{Binding AdvAvailability}"/>
                    </StackPanel>
                    <StackPanel MinWidth="110" Margin="0,0,16,8">
                        <TextBlock Text="Диаметр, мм" Style="{StaticResource HintTextStyle}"/>
                        <TextBox Text="{Binding AdvDiameter, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>
                    <StackPanel MinWidth="110" Margin="0,0,16,8">
                        <TextBlock Text="Толщина, мм" Style="{StaticResource HintTextStyle}"/>
                        <TextBox Text="{Binding AdvThickness, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>
                    <StackPanel MinWidth="110" Margin="0,0,16,8">
                        <TextBlock Text="Ширина, мм" Style="{StaticResource HintTextStyle}"/>
                        <TextBox Text="{Binding AdvWidth, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>
                    <StackPanel MinWidth="150">
                        <TextBlock Text="Разброс параметров, %" Style="{StaticResource HintTextStyle}"/>
                        <TextBox Text="{Binding AdvTolerance, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>
                </WrapPanel>
                <Border Background="{StaticResource SurfaceHoverBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="10,7"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ActiveFilterSummary, StringFormat=Активные условия: {0}}"
                               Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="12"
                Margin="0,8,0,0"
                Visibility="{Binding ShowBulkChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Обнаружено несколько номеров. Что сделать со списком?"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Найти все номера"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SearchAllNumbersCommand}"
                            ToolTip="Массовый поиск каждого номера"
                            Margin="0,0,8,0"/>
                    <Button Content="Добавить как список OEM"
                            Command="{Binding AddAsOemListCommand}"
                            ToolTip="Открыть форму новой позиции со списком OEM"
                            Margin="0,0,8,0"/>
                    <Button Content="Отмена"
                            Style="{StaticResource QuietButtonStyle}"
                            Command="{Binding ClearQuickCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,10,0,8">
            <Button Content="Найти" Command="{Binding FindCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4" Padding="22,5"/>
            <Button Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" IsEnabled="{Binding HasActiveFilters}" Margin="0,0,8,4"/>
            <Button Content="Копировать" Command="{Binding CopyCommand}" Margin="0,0,8,4"/>
            <Button Content="Номера и аналоги" Command="{Binding OpenNumbersCommand}" IsEnabled="{Binding HasSelectedRow}" Margin="0,0,12,4"/>
            <Button Content="Столбцы ▾"
                    Click="ColumnsMenu_OnClick"
                    ToolTip="Показать, скрыть и упорядочить столбцы"
                    Margin="0,0,8,4"/>
            <TextBlock Text="{Binding ConfirmationText}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="0,0,12,4"
                       Foreground="{StaticResource AccentBrush}"
                       Visibility="{Binding ConfirmationText, Converter={StaticResource NonEmptyStringToVisibility}}"/>
            <TextBlock Text="{Binding SearchErrorText}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,4"
                       Foreground="{StaticResource DangerBrush}"
                       Visibility="{Binding IsSearchError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding CounterText}" VerticalAlignment="Center" Margin="0,0,16,4"/>
            <TextBlock Text="{Binding CatalogInfoText}" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}"/>
        </WrapPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"
                                  MinWidth="320" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid x:Name="ResultsGrid"
                          ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          KeyDown="ResultsGrid_OnKeyDown"
                          MouseDoubleClick="ResultsGrid_OnMouseDoubleClick"
                          ui:DataGridColumns.TableKey="search"
                          ui:DataGridColumns.RequiredColumns="Наименование">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Копировать ячейку (Ctrl+C)" Click="CopyCell_OnClick"/>
                            <MenuItem Header="Копировать строку (Ctrl+Shift+C)" Click="CopyRow_OnClick"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,6,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер запчасти" Binding="{Binding Item.Code}" Width="110"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Item.Name}" Width="2*"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerDisplay}" Width="140"/>
                        <DataGridTextColumn Header="Ед." Binding="{Binding UnitDisplay}" Width="55"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="80"/>
                        <DataGridTemplateColumn Header="Статус" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Тип результата" Binding="{Binding ResultTypeDisplay}" Width="135"/>
                        <DataGridTextColumn Header="Найденный номер" Binding="{Binding MatchedNumber}" Width="180"/>
                        <DataGridTemplateColumn Header="Операции" Width="165">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Приход" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0" Padding="10,2"
                                                Command="{Binding DataContext.OperateReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Расход" Style="{StaticResource DangerButtonStyle}" Padding="10,2"
                                                Command="{Binding DataContext.OperateIssueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="360"
                        MaxWidth="560"
                        Visibility="{Binding IsEmptyResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyStateDescription}"
                                   Style="{StaticResource PageDescriptionStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,8,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" IsEnabled="{Binding HasActiveFilters}" Margin="0,0,8,0"/>
                            <Button Content="Добавить позицию" Command="{Binding GoToCatalogCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="16"
                        Visibility="{Binding ShowMassResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Сводка массового поиска" Style="{StaticResource SectionTitleStyle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Копировать" Command="{Binding CopyMassResultCommand}" Margin="0,0,8,0"/>
                                <Button Content="Закрыть" Style="{StaticResource QuietButtonStyle}" Command="{Binding CloseMassResultCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding MassSummaryLines}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding MassNotFoundText}"
                                   Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding MassNotFoundText, Converter={StaticResource NonEmptyStringToVisibility}}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1,0,0,0"
                    Margin="10,0,0,0"
                    Padding="0"
                    Visibility="{Binding PreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="True" KeyDown="PreviewPanel_OnKeyDown">
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceHoverBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,8">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="⇥"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Padding="8,2"
                                    ToolTip="Скрыть панель предпросмотра"
                                    Command="{Binding TogglePreviewCommand}"/>
                            <TextBlock Text="Карточка позиции" Style="{StaticResource SectionTitleStyle}"/>
                        </DockPanel>
                    </Border>
                    <views:ItemDetailsView x:Name="DetailsView"
                                           DataContext="{Binding Details}"/>
                </DockPanel>
            </Border>
        </Grid>

        <Button Grid.Row="4"
                Content="⇤ Предпросмотр"
                Style="{StaticResource QuietButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Command="{Binding TogglePreviewCommand}"
                Visibility="{Binding IsPreviewHidden, Converter={StaticResource BooleanToVisibilityConverter}}"
                ToolTip="Показать панель предпросмотра"/>
    </Grid>
</UserControl>
