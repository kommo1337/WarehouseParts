<Window x:Class="WarehouseParts.Views.ItemNumbersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="860" Height="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Номера позиции" FontWeight="Bold" Margin="0,0,0,4"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Numbers}" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип номера" Binding="{Binding TypeDisplay}" Width="120"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number.NumberRaw}" Width="220"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Number.Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Связанные позиции" FontWeight="Bold" Margin="0,10,0,4"/>
        <DataGrid Grid.Row="3" ItemsSource="{Binding RelatedItems}" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер запчасти" Binding="{Binding Item.Code}" Width="110"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Item.Name}" Width="*"/>
                <DataGridTextColumn Header="Текущий остаток" Binding="{Binding Stock}" Width="110"/>
                <DataGridTemplateColumn Header="Статус наличия" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Общий номер" Binding="{Binding CommonNumbers}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="4" Content="Закрыть" IsCancel="True" IsDefault="True" Padding="16,2"
                HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
