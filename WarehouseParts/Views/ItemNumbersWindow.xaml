<Window x:Class="WarehouseParts.Views.ItemNumbersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WarehouseParts.Ui"
        Title="{Binding Title}"
        Width="900" Height="540"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Номера позиции" Style="{StaticResource SectionTitleStyle}"/>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,4,0,4">
            <Button Content="Столбцы ▾" Click="NumberColumnsMenu_OnClick" ToolTip="Показать, скрыть и упорядочить столбцы" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Копировать номера" Command="{Binding CopyNumbersCommand}" Padding="12,3"/>
        </WrapPanel>
        <DataGrid x:Name="NumbersGrid" Grid.Row="2" ItemsSource="{Binding Numbers}" SelectedItem="{Binding SelectedNumber}"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                  KeyDown="NumbersGrid_OnKeyDown"
                  ui:DataGridColumns.TableKey="item-numbers"
                  ui:DataGridColumns.RequiredColumns="Номер">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Копировать ячейку (Ctrl+C)" Click="CopyNumberCell_OnClick"/>
                    <MenuItem Header="Копировать строку (Ctrl+Shift+C)" Click="CopyNumberRow_OnClick"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип номера" Binding="{Binding TypeDisplay}" Width="120"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number.NumberRaw}" Width="230"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Number.Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="Связанные позиции" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,0"/>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,4,0,4">
            <Button Content="Столбцы ▾" Click="RelatedColumnsMenu_OnClick" ToolTip="Показать, скрыть и упорядочить столбцы" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Копировать код позиции" Command="{Binding CopyRelatedCodeCommand}" IsEnabled="{Binding HasSelectedRelatedItem}" Padding="12,3"/>
        </WrapPanel>
        <DataGrid x:Name="RelatedGrid" Grid.Row="5" ItemsSource="{Binding RelatedItems}" SelectedItem="{Binding SelectedRelatedItem}"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                  KeyDown="RelatedGrid_OnKeyDown"
                  ui:DataGridColumns.TableKey="item-related"
                  ui:DataGridColumns.RequiredColumns="Наименование">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер запчасти" Binding="{Binding Item.Code}" Width="120"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Item.Name}" Width="2*"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="90"/>
                <DataGridTemplateColumn Header="Статус" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Общий номер" Binding="{Binding CommonNumbers}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="6" Content="Закрыть" IsCancel="True" IsDefault="True" Padding="18,4"
                HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>
