<UserControl x:Class="WarehouseParts.Views.ItemDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WarehouseParts.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <ui:OperationTypeTextConverter x:Key="OperationTypeTextConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Focusable="False"
                  Visibility="{Binding HasItem, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Margin="16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="{Binding Item.Code}"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="⧉"
                        ToolTip="Скопировать код (Ctrl+C в таблице копирует строку)"
                        Style="{StaticResource QuietButtonStyle}"
                        Padding="6,0"
                        Command="{Binding CopyCodeCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Item.Name}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding Stock, StringFormat={}Остаток: {0}}"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/>
            </StackPanel>

            <TextBlock Text="Производитель" Style="{StaticResource HintTextStyle}"/>
            <TextBlock Text="{Binding ManufacturerDisplay}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock Text="Применимость к автомобилю" Style="{StaticResource HintTextStyle}"/>
            <TextBlock Text="{Binding ApplicabilityDisplay}" TextWrapping="Wrap" Margin="0,0,10,0"/>

            <TextBlock Text="Размеры" Style="{StaticResource HintTextStyle}"/>
            <TextBlock Text="{Binding ParametersDisplay}" TextWrapping="Wrap" Margin="0,0,10,0"/>

            <TextBlock Text="Комментарий" Style="{StaticResource HintTextStyle}"/>
            <TextBlock Text="{Binding CommentDisplay}" TextWrapping="Wrap" Margin="0,0,14,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Приход"
                        x:Name="ReceiptButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ReceiptCommand}"
                        ToolTip="Провести приход (Ctrl+R)"
                        Margin="0,0,8,0"/>
                <Button Content="Расход"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding IssueCommand}"
                        ToolTip="Провести расход (Ctrl+I)"
                        Margin="0,0,8,0"/>
                <Button Content="Изменить"
                        Command="{Binding EditCommand}"
                        ToolTip="Редактировать позицию"
                        Margin="0,0,8,0"/>
                <Button Content="+ Номер"
                        Command="{Binding AddNumberCommand}"
                        ToolTip="Добавить OEM/номер к позиции"/>
            </StackPanel>

            <TextBlock Text="Номера" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding Numbers}" Margin="0,0,0,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TypeDisplay}" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Number.NumberRaw}" TextWrapping="Wrap"/>
                            <Button Grid.Column="2"
                                    Content="⧉"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Padding="6,0"
                                    ToolTip="Скопировать номер"
                                    Command="{Binding DataContext.CopyNumberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Связанные позиции" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding RelatedItems}" Margin="0,0,0,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock>
                                <Run Text="{Binding Item.Code, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Item.Name, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HintTextStyle}">
                                <Run Text="{Binding CommonNumbers, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Status, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Последние операции" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding RecentOperations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding OperationType, Converter={StaticResource OperationTypeTextConverter}}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource HintTextStyle}">
                                    <Run Text="+"/>
                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Comment}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
