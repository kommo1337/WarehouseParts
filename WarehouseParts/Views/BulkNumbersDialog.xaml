<Window x:Class="WarehouseParts.Views.BulkNumbersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:WarehouseParts.Data"
        Title="Добавить список номеров"
        Width="440" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Тип номера"/>
        <ComboBox x:Name="TypeCombo" ItemsSource="{x:Static data:DisplayTexts.NumberTypes}" SelectedIndex="0" Margin="0,2,0,8"/>

        <TextBlock Text="Номера (каждая строка — отдельный номер)"/>
        <TextBox x:Name="NumbersText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Height="220" Margin="0,2,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" IsDefault="True" Padding="12,2" Margin="0,0,8,0"/>
            <Button Content="Отмена" IsCancel="True" Padding="12,2"/>
        </StackPanel>
    </StackPanel>
</Window>
