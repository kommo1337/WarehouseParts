<Window x:Class="WarehouseParts.Views.BulkNumbersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:WarehouseParts.Data"
        Title="Добавить список номеров"
        Width="440" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NumbersText}"
        KeyDown="BulkNumbersDialog_OnKeyDown">
    <StackPanel Margin="16">
        <TextBlock Text="Тип номера" Style="{StaticResource HintTextStyle}"/>
        <ComboBox x:Name="TypeCombo" ItemsSource="{x:Static data:DisplayTexts.NumberTypes}" SelectedIndex="0" Margin="0,3,0,10"/>

        <TextBlock Text="Номера (каждая строка — отдельный номер)" Style="{StaticResource HintTextStyle}"/>
        <TextBox x:Name="NumbersText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Height="220" Margin="0,3,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить все" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Padding="18,5" Margin="0,0,8,0" ToolTip="Добавить все номера (Ctrl+Enter)"/>
            <Button Content="Отмена" IsCancel="True" Padding="18,5" ToolTip="Отмена (Esc)"/>
        </StackPanel>
    </StackPanel>
</Window>
