<Window x:Class="WarehouseParts.Views.OperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:WarehouseParts.Data"
        xmlns:ui="clr-namespace:WarehouseParts.Ui"
        Title="{Binding TitleText}"
        Width="560" SizeToContent="Height"
        MinWidth="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=FilterBox}"
        KeyDown="OperationDialog_OnKeyDown">
    <Window.Resources>
        <ui:StringToVisibilityConverter x:Key="EmptyStringToVisibility" Invert="True"/>
        <ui:StringToVisibilityConverter x:Key="NonEmptyStringToVisibility"/>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="{Binding TitleText}"
                   Style="{StaticResource SectionTitleStyle}"
                   Margin="0,0,0,14"/>

        <TextBlock Text="Операция" Style="{StaticResource HintTextStyle}"/>
        <ComboBox ItemsSource="{x:Static data:DisplayTexts.Operations}"
                  SelectedItem="{Binding OperationTypeText}"
                  Margin="0,3,0,10"/>

        <TextBlock Text="Запчасть" Style="{StaticResource HintTextStyle}"/>
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2"
                Margin="0,3,0,5">
            <Grid>
                <TextBlock Text="Введите код или наименование"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           IsHitTestVisible="False"
                           Visibility="{Binding FilterText, Converter={StaticResource EmptyStringToVisibility}}"/>
                <TextBox x:Name="FilterBox"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Filter_OnKeyDown"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,6"/>
            </Grid>
        </Border>
        <TextBlock Text="{Binding ItemError}"
                   Foreground="{StaticResource DangerBrush}"
                   Margin="0,0,0,5"
                   Visibility="{Binding ItemError, Converter={StaticResource NonEmptyStringToVisibility}}"/>

        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Background="{StaticResource SurfaceBrush}"
                Margin="0,0,0,8">
            <Grid>
                <ListBox ItemsSource="{Binding ItemChoices}"
                         SelectedItem="{Binding SelectedChoice}"
                         DisplayMemberPath="DisplayText"
                         MinHeight="150" MaxHeight="220"
                         BorderThickness="0"
                         Background="Transparent"/>
                <TextBlock Text="{Binding ChoicesStatusText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           IsHitTestVisible="False"
                           Visibility="{Binding ChoicesStatusText, Converter={StaticResource NonEmptyStringToVisibility}}"/>
            </Grid>
        </Border>

        <Border Background="{StaticResource SurfaceHoverBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,7"
                Margin="0,0,0,12"
                Visibility="{Binding HasSelectedItem, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding SelectedChoice.DisplayText}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <TextBlock Text="Количество" Style="{StaticResource HintTextStyle}"/>
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2"
                Margin="0,3,0,5">
            <Grid>
                <TextBlock Text="Введите целое число больше нуля"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           IsHitTestVisible="False"
                           Visibility="{Binding QuantityText, Converter={StaticResource EmptyStringToVisibility}}"/>
                <TextBox x:Name="QuantityBox"
                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,6"/>
            </Grid>
        </Border>
        <TextBlock Text="{Binding QuantityError}"
                   Foreground="{StaticResource DangerBrush}"
                   Margin="0,0,0,5"
                   Visibility="{Binding QuantityError, Converter={StaticResource NonEmptyStringToVisibility}}"/>
        <TextBlock Text="{Binding AvailableStockText}" Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIssue}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="Комментарий" Style="{StaticResource HintTextStyle}"/>
        <TextBox Text="{Binding Comment}"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Height="56"
                 TextWrapping="Wrap"
                 Margin="0,3,0,14"/>

        <TextBlock Text="Сохранение операции…"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,8"
                   Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Padding="18,5" Margin="0,0,8,0" IsEnabled="{Binding CanSave}" ToolTip="Сохранить операцию (Enter или Ctrl+Enter)"/>
            <Button Content="Отмена" IsCancel="True" Padding="18,5" ToolTip="Отмена (Esc)"/>
        </StackPanel>
    </StackPanel>
</Window>
