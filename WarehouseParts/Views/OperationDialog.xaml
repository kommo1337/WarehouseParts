<Window x:Class="WarehouseParts.Views.OperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:WarehouseParts.Data"
        Title="Новая операция"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Операция"/>
        <ComboBox ItemsSource="{x:Static data:DisplayTexts.Operations}" SelectedItem="{Binding OperationTypeText}" Margin="0,2,0,8"/>

        <TextBlock Text="Запчасть (введите номер или наименование)"/>
        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="Filter_OnKeyDown" Margin="0,2,0,4"/>
        <ListBox ItemsSource="{Binding ItemChoices}"
                 SelectedItem="{Binding SelectedChoice}"
                 DisplayMemberPath="DisplayText"
                 MinHeight="140" MaxHeight="220" Margin="0,0,0,8"/>

        <TextBlock Text="Количество"/>
        <TextBox x:Name="QuantityBox" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
        <TextBlock Text="{Binding AvailableStockText}" Foreground="DarkRed" Margin="0,0,0,8"/>

        <TextBlock Text="Комментарий"/>
        <TextBox Text="{Binding Comment}" Margin="0,2,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" IsDefault="True" Padding="12,2" Margin="0,0,8,0"/>
            <Button Content="Отмена" IsCancel="True" Padding="12,2"/>
        </StackPanel>
    </StackPanel>
</Window>
