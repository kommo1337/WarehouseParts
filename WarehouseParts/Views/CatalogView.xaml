<UserControl x:Class="WarehouseParts.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WarehouseParts.Ui"
             xmlns:vm="clr-namespace:WarehouseParts.ViewModels"
             xmlns:views="clr-namespace:WarehouseParts.Views">
    <UserControl.Resources>
        <ui:StringToVisibilityConverter x:Key="EmptyStringToVisibility" Invert="True"/>
        <ui:StringToVisibilityConverter x:Key="NonEmptyStringToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <StackPanel MinWidth="320" MaxWidth="560" Width="420">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="2">
                            <Grid>
                                <TextBlock Text="Фильтр по коду, наименованию или производителю"
                                           Margin="10,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="{Binding FilterText, Converter={StaticResource EmptyStringToVisibility}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="8,6"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1"
                                Content="×"
                                ToolTip="Очистить фильтр"
                                Command="{Binding ClearFilterCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,2"
                                Visibility="{Binding FilterText, Converter={StaticResource NonEmptyStringToVisibility}}"/>
                    </Grid>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource HintTextStyle}" Margin="2,4,0,0"/>
                    <TextBlock Text="{Binding QualityCountsText}" Style="{StaticResource HintTextStyle}" Margin="2,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <TextBlock Text="Качество данных" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{x:Static vm:CatalogViewModel.QualityFilterOptions}"
                              SelectedItem="{Binding QualityFilterText}"
                              Width="170"/>
                </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Столбцы ▾" Click="ColumnsMenu_OnClick" ToolTip="Показать, скрыть и упорядочить столбцы" Padding="12,5" Margin="6,0,0,4"/>
                <Button Content="Добавить" Command="{Binding AddItemCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,5" Margin="6,0,0,4" ToolTip="Добавить позицию (Ctrl+N)"/>
                <Button Content="Изменить" Command="{Binding EditItemCommand}" IsEnabled="{Binding HasSelectedItem}" Padding="14,5" Margin="6,0,0,4" ToolTip="Изменить позицию"/>
                <Button Content="Номера и аналоги" Command="{Binding ShowNumbersCommand}" IsEnabled="{Binding HasSelectedItem}" Padding="14,5" Margin="6,0,0,4"/>
                <Button Content="Удалить" Command="{Binding DeleteItemCommand}" IsEnabled="{Binding HasSelectedItem}" Style="{StaticResource DangerButtonStyle}" Padding="14,5" Margin="6,0,0,4"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                          IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                          KeyDown="ItemsGrid_OnKeyDown"
                          MouseDoubleClick="ItemsGrid_OnMouseDoubleClick"
                          PreviewMouseRightButtonDown="ItemsGrid_OnPreviewMouseRightButtonDown"
                          ui:DataGridColumns.TableKey="catalog"
                          ui:DataGridColumns.RequiredColumns="Номер запчасти">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastAdded}" Value="True">
                                    <Setter Property="Background" Value="#FFF6D9"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLastAdded}" Value="True"/>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#FFE9A8"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Копировать ячейку (Ctrl+C)" Click="CopyItemCell_OnClick"/>
                            <MenuItem Header="Копировать строку (Ctrl+Shift+C)" Click="CopyItemRow_OnClick"/>
                            <Separator/>
                            <MenuItem Header="Копировать артикул" Command="{Binding CopyItemCodeCommand}"/>
                            <Separator/>
                            <MenuItem Header="Изменить" Command="{Binding EditItemCommand}"/>
                            <MenuItem Header="Номера и аналоги" Command="{Binding ShowNumbersCommand}"/>
                            <MenuItem Header="Удалить" Command="{Binding DeleteItemCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Номер запчасти" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Item.Code}" VerticalAlignment="Center"/>
                                        <Button Content="⧉"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Padding="6,0"
                                                ToolTip="Скопировать код"
                                                Click="CopyCodeCell_OnClick"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Item.Name}" Width="2*"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Item.Manufacturer}" Width="140"/>
                        <DataGridTextColumn Header="Ед." Binding="{Binding UnitDisplay}" Width="55"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="80"/>
                        <DataGridTemplateColumn Header="Статус" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="340"
                        MaxWidth="520"
                        Visibility="{Binding IsCatalogEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyDescription}"
                                   Style="{StaticResource PageDescriptionStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,8,0,16"/>
                        <Button Content="Добавить позицию" Command="{Binding AddItemCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="340"
                        MaxWidth="520"
                        Visibility="{Binding IsFilterEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyDescription}"
                                   Style="{StaticResource PageDescriptionStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,8,0,16"/>
                        <Button Content="Очистить фильтр" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Width="380"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1,0,0,0"
                    Margin="10,0,0,0">
                <DockPanel LastChildFill="True" KeyDown="PreviewPanel_OnKeyDown">
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceHoverBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,8">
                        <TextBlock Text="Карточка позиции" Style="{StaticResource SectionTitleStyle}"/>
                    </Border>
                    <views:ItemDetailsView x:Name="DetailsView"
                                           DataContext="{Binding Details}"/>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding NumbersHeader}" FontWeight="SemiBold"/>
                <TextBlock Text="Выберите позицию в таблице, чтобы увидеть её номера."
                           Style="{StaticResource HintTextStyle}"
                           Visibility="{Binding SelectedItemText, Converter={StaticResource EmptyStringToVisibility}}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Столбцы ▾" Click="NumberColumnsMenu_OnClick" ToolTip="Показать, скрыть и упорядочить столбцы номеров" Padding="12,4" Margin="6,0,0,4"/>
                <Button Content="Добавить" Command="{Binding AddNumberCommand}" IsEnabled="{Binding HasSelectedItem}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,4" Margin="6,0,0,4" ToolTip="Добавить один номер"/>
                <Button Content="Добавить список" Command="{Binding BulkAddNumbersCommand}" IsEnabled="{Binding HasSelectedItem}" Padding="14,4" Margin="6,0,0,4" ToolTip="Массовое добавление номеров списком"/>
                <Button Content="Изменить" Command="{Binding EditNumberCommand}" IsEnabled="{Binding HasSelectedNumber}" Padding="14,4" Margin="6,0,0,4"/>
                <Button Content="Удалить" Command="{Binding DeleteNumberCommand}" IsEnabled="{Binding HasSelectedNumber}" Style="{StaticResource DangerButtonStyle}" Padding="14,4" Margin="6,0,0,4"/>
            </WrapPanel>
        </Grid>

        <DataGrid x:Name="NumbersGrid" Grid.Row="3" ItemsSource="{Binding Numbers}" SelectedItem="{Binding SelectedNumber}"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                  KeyDown="NumbersGrid_OnKeyDown"
                  ui:DataGridColumns.TableKey="catalog-numbers"
                  ui:DataGridColumns.RequiredColumns="Номер">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Копировать ячейку (Ctrl+C)" Click="CopyNumberCell_OnClick"/>
                    <MenuItem Header="Копировать строку (Ctrl+Shift+C)" Click="CopyNumberRow_OnClick"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип номера" Binding="{Binding TypeDisplay}" Width="110"/>
                <DataGridTemplateColumn Header="Номер" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Number.NumberRaw}" VerticalAlignment="Center"/>
                                <Button Content="⧉"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Padding="6,0"
                                        ToolTip="Скопировать номер"
                                        Click="CopyNumberValue_OnClick"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Number.Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
