<UserControl x:Class="WarehouseParts.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WarehouseParts.ViewModels">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Добавить" Command="{Binding AddItemCommand}"
                    FontSize="14" Padding="24,8" ToolTip="Добавить позицию (Ctrl+N)"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="ItemsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                  MouseDoubleClick="ItemsGrid_OnMouseDoubleClick"
                  PreviewMouseRightButtonDown="ItemsGrid_OnPreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLastAdded}" Value="True">
                            <Setter Property="Background" Value="#FFF6D9"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLastAdded}" Value="True"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#FFE9A8"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Копировать артикул" Command="{Binding CopyItemCodeCommand}"/>
                    <Separator/>
                    <MenuItem Header="Изменить" Command="{Binding EditItemCommand}"/>
                    <MenuItem Header="Удалить" Command="{Binding DeleteItemCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер запчасти" Binding="{Binding Item.Code}" Width="110"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Item.Name}" Width="*"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Item.Manufacturer}" Width="130"/>
                <DataGridTextColumn Header="Единица измерения" Binding="{Binding UnitDisplay}" Width="90"/>
                <DataGridTextColumn Header="Диаметр, мм" Binding="{Binding Item.Diameter}" Width="90"/>
                <DataGridTextColumn Header="Толщина, мм" Binding="{Binding Item.Thickness}" Width="90"/>
                <DataGridTextColumn Header="Ширина, мм" Binding="{Binding Item.Width}" Width="90"/>
                <DataGridTextColumn Header="Применимость к автомобилю" Binding="{Binding Item.CarApplicability}" Width="220"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Item.Comment}" Width="140"/>
                <DataGridTextColumn Header="Текущий остаток" Binding="{Binding Stock}" Width="100"/>
                <DataGridTemplateColumn Header="Статус наличия" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
            <TextBlock Text="Номера позиции" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Добавить" Command="{Binding AddNumberCommand}" Padding="10,2" Margin="0,0,6,0"/>
            <Button Content="Добавить список" Command="{Binding BulkAddNumbersCommand}" Padding="10,2" Margin="0,0,6,0"/>
            <Button Content="Изменить" Command="{Binding EditNumberCommand}" Padding="10,2" Margin="0,0,6,0"/>
            <Button Content="Удалить" Command="{Binding DeleteNumberCommand}" Padding="10,2"/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Numbers}" SelectedItem="{Binding SelectedNumber}"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип номера" Binding="{Binding TypeDisplay}" Width="110"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number.NumberRaw}" Width="220"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Number.Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
